#!/bin/bash
set -uo pipefail

. /usr/share/saltos-omakase/lib/omakase.sh

export TERM="${TERM:-linux}"
mkdir -p "$OMAKASE_RUN"
chmod 700 "$OMAKASE_RUN"

center() {
  local cols rows text_rows=0 width=0 line
  cols=$(tput cols); rows=$(tput lines)
  while IFS= read -r line; do
    text_rows=$((text_rows + 1))
    [ ${#line} -gt $width ] && width=${#line}
  done <<<"$1"
  local top=$(( (rows - text_rows) / 2 - 2 )) left=$(( (cols - width) / 2 ))
  [ $top -lt 0 ] && top=0
  [ $left -lt 0 ] && left=0
  printf '\e[H\e[J'
  for ((i = 0; i < top; i++)); do printf '\n'; done
  while IFS= read -r line; do
    printf '%*s%s\n' "$left" '' "$line"
  done <<<"$1"
}

greeter() {
  saltos-vt-palette
  local logo prompt
  logo="$(cat "$OMAKASE_SHARE/live/logo.txt")"
  prompt=$'\n\n'"$(gum style --foreground 4 --bold 'Press Return to Start Install')"
  center "$logo"$'\n'"$(gum style --foreground 5 'omakase edition')"$'\n'"$prompt"
  printf '\e[?25h'
  local rc=0
  trap 'rc=130' INT
  IFS= read -r _
  trap - INT
  return $rc
}

prepare_for_another_owner() {
  clear
  gum style --border rounded --padding "1 3" --border-foreground 5 \
    "$(gum style --bold 'Prepare this machine for another owner?')" "" \
    "The system is installed now with a placeholder account." \
    "The new owner picks keyboard layout, name, password and hostname" \
    "on their first boot, before the desktop starts."
  echo
  if gum confirm --default=false "Install for another owner?"; then
    : >"$OMAKASE_DEFERRED"
    return 0
  fi
  rm -f "$OMAKASE_DEFERRED"
  return 1
}

run_dashboard() {
  saltos-install-dashboard
}

fail_shell() {
  printf '\e[?25h'
  echo
  gum style --foreground 1 --bold "$1"
  echo "Log: $OMAKASE_LOG"
  echo "Press Return for a shell, Ctrl+Alt+Del to reboot."
  read -r _
  exec bash -l
}

saltos-cidata-load
case $? in
  0) run_dashboard || fail_shell "Unattended install failed"; exit 0 ;;
  2) fail_shell "Invalid cidata configuration" ;;
esac

while :; do
  greeter
  rc=$?
  if [ $rc -eq 130 ]; then
    prepare_for_another_owner
  fi
  printf '\e[?25h'
  clear
  if saltos-configurator; then
    run_dashboard || fail_shell "Install failed"
    exit 0
  fi
  rm -f "$OMAKASE_CONFIG" "$OMAKASE_CREDENTIALS"
done
