#!/bin/sh
set -u

usage() { echo "usage: saltos-host ota [salt-ota args...]" >&2; exit 2; }

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -n /opt/saltos/bin/saltos-host "$@"
fi

if [ "$(readlink /proc/self/ns/mnt)" != "$(readlink /proc/1/ns/mnt)" ]; then
  exec nsenter -t 1 -m -r -- /opt/saltos/bin/saltos-host "$@"
fi

[ $# -ge 1 ] || usage
what="$1"
shift
case "$what" in
  ota)
    for ota in /usr/bin/salt-ota /usr/local/bin/salt-ota; do
      [ -x "$ota" ] && exec "$ota" "$@"
    done
    echo "saltos-host: salt-ota is not installed" >&2
    exit 1
    ;;
  *) usage ;;
esac
