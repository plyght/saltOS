#!/bin/sh
exec 2>&1
[ -d /run/udev ] || mkdir -p /run/udev
udevd=""
for d in /usr/bin/udevd /sbin/udevd /usr/lib/systemd/systemd-udevd /lib/systemd/systemd-udevd; do
  [ -x "$d" ] && { udevd="$d"; break; }
done
[ -n "$udevd" ] || { echo "udevd: no udev daemon found"; exec sleep 60; }
(
  udevadm control --ping --timeout=30 >/dev/null 2>&1 || sleep 2
  udevadm trigger --action=add --type=subsystems
  udevadm trigger --action=add --type=devices
  udevadm settle --timeout=30
) &
exec "$udevd"
